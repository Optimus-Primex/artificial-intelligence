# Network used when a request omits ?network= (mainnet | testnet | futurenet)
STELLAR_AI_DEFAULT_NETWORK=testnet

# LLM provider: static (deterministic, offline) | openai | openai-compatible.
# For openai, set the key/model below (base URL can point at a local gateway).
STELLAR_AI_LLM_PROVIDER=static

# Comma-separated bearer tokens. Empty disables authentication (development only).
STELLAR_AI_API_KEYS=

# Comma-separated allowed CORS origins. Empty disables CORS.
STELLAR_AI_CORS_ORIGINS=

# Log format: text | json
STELLAR_AI_LOG_FORMAT=text

# Outbound request timeout, in seconds.
STELLAR_AI_REQUEST_TIMEOUT=10

# Optional endpoint overrides (otherwise per-network defaults are used).
STELLAR_AI_HORIZON_URL=
STELLAR_AI_SOROBAN_RPC_URL=

# Whale-transfer detection used by POST /api/v1/analyze.
# Asset label: XLM (native) or CODE:ISSUER (e.g. USDC:G...).
STELLAR_AI_WHALE_ASSET=XLM
# Transfers at or above this amount are reported as alerts.
STELLAR_AI_WHALE_THRESHOLD=100000
# Number of recent Horizon payments to scan (1-200).
STELLAR_AI_PAYMENT_LIMIT=50

# Ledger anomaly detection (see README). Thresholds are in seconds.
STELLAR_AI_LEDGER_HISTORY_LIMIT=20
STELLAR_AI_MAX_LEDGER_LAG_SECONDS=30
STELLAR_AI_MAX_CLOSE_INTERVAL_SECONDS=30
STELLAR_AI_CLOSE_INTERVAL_OUTLIER_FACTOR=3

STELLAR_AI_LLM_API_KEY=
STELLAR_AI_LLM_MODEL=gpt-4o-mini
STELLAR_AI_LLM_BASE_URL=https://api.openai.com/v1
STELLAR_AI_LLM_TIMEOUT=30

