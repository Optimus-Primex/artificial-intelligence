{
  "name": "@optimus-primex/ai-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Stellar AI service",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Optimus-Primex/artificial-intelligence.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/Optimus-Primex/artificial-intelligence#readme",
  "bugs": {
    "url": "https://github.com/Optimus-Primex/artificial-intelligence/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "ai",
    "llm",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
